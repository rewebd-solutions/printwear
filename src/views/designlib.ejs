<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Import Bootstrap CSS -->
  <!-- Import custom CSS file -->
  <link rel="stylesheet" href="/css/designlib.css">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
  <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v6.0.0-beta3/css/all.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
  <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
  <title>Design Library - Printwear</title>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-H19W9PLCHF">
  </script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-H19W9PLCHF');
  </script>
</head>

<body>

  <!-- navbar -->
  <!-- Navbar starts here -->
  <div class="banner">
    <%- include('partials/side-logo.ejs') %>
      <%- include('partials/top.ejs') %>
  </div>
  <!-- navbar  -->


  <main class="product-lib">
    <div class="heading-row">
      <div style="display: flex; flex-direction: column;">
        <h2>Your Product Library</h2>
        <p>View your designs and check out pricing<br>
          You can also push them to your online store once you connect your store with Printwear or place an order with
          them.</p>
      </div>
      <input type="search" placeholder="Search by name or SKU..."
        oninput="searchDesigns('designName', event.target.value)" id="name-search" />
    </div>
    <div class="filter-container">
      <h3>Filter by category</h3>
      <div class="gender-filter">
        <button class="filter-button filter-button-active" onclick="filterProductsByGender(event, 'all')">All</button>
        <button class="filter-button" onclick="filterProductsByGender(event,'men')">Men</button>
        <button class="filter-button" onclick="filterProductsByGender(event, 'women')">Women</button>
        <button class="filter-button" onclick="filterProductsByGender(event, 'unisex')">Unisex</button>
      </div>

      <!-- Pagination Controls -->
      <div class="pagination-controls">
        <div class="results-per-page">
          <label for="itemsPerPage">Items per page:</label>
          <select id="itemsPerPage" onchange="changeItemsPerPage(event)">
            <option value="12">12</option>
            <option value="24">24</option>
            <option value="48">48</option>
          </select>
        </div>
        <div class="pagination-info">
          <span id="pagination-info-text">Showing 0 - 0 of 0 designs</span>
        </div>
      </div>
    </div>

    <div class="designs-wrapper">
      <span class="loader"></span>
    </div>

    <!-- Pagination Navigation -->
    <div class="pagination-nav" id="pagination-nav" style="display: none;">
      <button id="prev-btn" onclick="goToPreviousPage()" disabled>
        <i class="fa fa-chevron-left"></i> Previous
      </button>
      <div class="page-numbers" id="page-numbers"></div>
      <button id="next-btn" onclick="goToNextPage()" disabled>
        Next <i class="fa fa-chevron-right"></i>
      </button>
    </div>

  </main>

  <script src="/js/vendor/aos.min.js"></script>
  <script>
    AOS.init();
    var notyf = new Notyf();

    const designsContainer = document.querySelector(".designs-wrapper");
    var designsResponseData = {};
    var currentModalDesign = null; // Store current design data for downloads

    // Pagination variables
    let currentPage = 1;
    let itemsPerPage = 12;
    let totalDesigns = 0;
    let currentFilteredData = null;
    let totalPages = 1;

    // Pagination functions
    const updatePaginationInfo = () => {
      const start = (currentPage - 1) * itemsPerPage + 1;
      const end = Math.min(currentPage * itemsPerPage, totalDesigns);
      document.getElementById('pagination-info-text').textContent =
        `Showing ${start} - ${end} of ${totalDesigns} designs`;
    };

    const updatePaginationNav = () => {
      const paginationNav = document.getElementById('pagination-nav');
      const pageNumbers = document.getElementById('page-numbers');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');

      if (totalPages <= 1) {
        paginationNav.style.display = 'none';
        return;
      }

      paginationNav.style.display = 'flex';

      // Update prev/next buttons
      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage === totalPages;

      // Generate page numbers
      let pageNumbersHTML = '';
      const maxVisiblePages = 5;
      let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
      let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

      if (endPage - startPage < maxVisiblePages - 1) {
        startPage = Math.max(1, endPage - maxVisiblePages + 1);
      }

      if (startPage > 1) {
        pageNumbersHTML += `<button class="page-btn" onclick="goToPage(1)">1</button>`;
        if (startPage > 2) {
          pageNumbersHTML += `<span class="page-ellipsis">...</span>`;
        }
      }

      for (let i = startPage; i <= endPage; i++) {
        pageNumbersHTML += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
      }

      if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
          pageNumbersHTML += `<span class="page-ellipsis">...</span>`;
        }
        pageNumbersHTML += `<button class="page-btn" onclick="goToPage(${totalPages})">${totalPages}</button>`;
      }

      pageNumbers.innerHTML = pageNumbersHTML;
    };

    const goToPage = (page) => {
      if (page < 1 || page > totalPages) return;
      currentPage = page;
      createDesignCards(currentFilteredData);
    };

    const goToPreviousPage = () => {
      if (currentPage > 1) {
        goToPage(currentPage - 1);
      }
    };

    const goToNextPage = () => {
      if (currentPage < totalPages) {
        goToPage(currentPage + 1);
      }
    };

    const changeItemsPerPage = (event) => {
      itemsPerPage = parseInt(event.target.value);
      currentPage = 1;
      createDesignCards(currentFilteredData);
    };

    const paginateData = (allDesigns) => {
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      return allDesigns.slice(startIndex, endIndex);
    };

    const searchDesigns = (dataKey, searchKey) => {
      if (searchKey === '') {
        currentFilteredData = designsResponseData;
        currentPage = 1;
        return createDesignCards();
      }

      let filteredData = { standalone: [], grouped: [], designs: [] };

      // Search in standalone designs
      if (designsResponseData.standalone && Array.isArray(designsResponseData.standalone)) {
        filteredData.standalone = designsResponseData.standalone.filter(design =>
          (design[dataKey] && design[dataKey].toLowerCase().trim().includes(searchKey.toLowerCase().trim())) ||
          (design["designSKU"] && design["designSKU"].toLowerCase().trim().includes(searchKey.toLowerCase().trim()))
        );
      }

      // Search in grouped designs
      // Handle grouped data as an object with groupId keys
      if (designsResponseData.grouped && typeof designsResponseData.grouped === 'object') {
        const filteredGroups = {};
        Object.entries(designsResponseData.grouped).forEach(([groupId, designs]) => {
          if (designs && Array.isArray(designs)) {
            const matchingDesigns = designs.filter(design =>
              (design[dataKey] && design[dataKey].toLowerCase().trim().includes(searchKey.toLowerCase().trim())) ||
              (design["designSKU"] && design["designSKU"].toLowerCase().trim().includes(searchKey.toLowerCase().trim()))
            );
            if (matchingDesigns.length > 0) {
              filteredGroups[groupId] = designs; // Include the whole group if any design matches
            }
          }
        });
        filteredData.grouped = filteredGroups;
      }

      // Search in original designs array as fallback
      if (designsResponseData.designs && Array.isArray(designsResponseData.designs)) {
        filteredData.designs = designsResponseData.designs.filter(design =>
          (design[dataKey] && design[dataKey].toLowerCase().trim().includes(searchKey.toLowerCase().trim())) ||
          (design["designSKU"] && design["designSKU"].toLowerCase().trim().includes(searchKey.toLowerCase().trim()))
        );
      }

      if (filteredData.standalone.length === 0 && Object.keys(filteredData.grouped).length === 0 && filteredData.designs.length === 0) {
        designsContainer.innerHTML = 'No designs found matching your search';
        document.getElementById('pagination-nav').style.display = 'none';
        document.getElementById('pagination-info-text').textContent = 'Showing 0 - 0 of 0 designs';
        return;
      }

      currentFilteredData = filteredData;
      currentPage = 1;
      createDesignCards(filteredData);
    }

    const disableButton = (buttonElement, innerTextBefore, innerTextAfter, state) => {
      state ? buttonElement.setAttribute("disabled", true) : buttonElement.removeAttribute("disabled");
      state ? buttonElement.classList.add("disabled") : buttonElement.classList.remove("disabled");
      state ? buttonElement.innerHTML = `${innerTextBefore}` : buttonElement.innerHTML = `<i class="fa-regular fa-page"></i> ${innerTextAfter}`;
    }

    const openDeleteConfirmation = (button, designName, designSKU) => {
      if (prompt("Deleting the design will completely erase your design from the database. You will not be able to place orders with this design. You will also not be able to process Shopify or WooCommerce orders that have this design as line item.\n Are you sure you wish to delete the design " + designName + "\n Type the design's name to delete it:") === designName) deleteDesign(button, designSKU)
      else alert("Design was not deleted")
    }

    const deleteDesign = async (button, designSKU) => {
      disableButton(button, "Deleting...", "Deleted", true);
      try {
        const deleteDesignRequest = await fetch("/deletedesign", {
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            designSKU
          }),
          method: 'POST'
        });
        const deleteDesignResponse = await deleteDesignRequest.json();
        if (!deleteDesignRequest.ok) return notyf.error({ message: deleteDesignResponse.error })
        notyf.success({
          message: "Design deleted successfully",
          dismissible: true,
          duration: 5000
        })
        document.querySelector("main").removeChild(document.querySelector(".product-modal-wrapper"))
        fetchDesignsData();
      } catch (error) {
        console.log(error);
        return notyf.error("Unable to delete design")
      }
    }

    const addToShopify = async (button, designSKU) => {
      disableButton(button, "Adding...", "Added to Shopify", true);
      try {
        const priceInput = document.querySelector(".shop-price");
        if (/^\d+$/.test(priceInput.value) && (parseInt(priceInput.value) <= 0)) return notyf.error("Invalid Price");
        const addToshopifyRequest = await fetch("/createshopifyproduct", {
          headers: {
            "Content-Type": "application/json"
          },
          method: "POST",
          body: JSON.stringify({
            designSKU,
            price: parseInt(priceInput.value)
          }),
        });
        const addToshopifyResponse = await addToshopifyRequest.json();
        if (!addToshopifyRequest.ok) {
          document.querySelector("main").removeChild(document.querySelector(".product-modal-wrapper"))
          return notyf.error({
            message: addToshopifyResponse.error ?? addToshopifyResponse.message,
            dismissible: true,
            duration: 5000
          })
        }
        notyf.success({
          message: "Added to shopify Store!",
          dismissible: true,
          duration: 5000
        })
        const modal = document.querySelector(".product-modal-wrapper")
        if (modal) document.querySelector("main").removeChild(modal)
      } catch (error) {
        console.log(error);
        notyf.error("Something went wrong!");
      } finally {
        disableButton(button, "Adding...", "Add to Shopify", false);
      }
    }

    const addToWooCommerce = async (button, designSKU) => {
      disableButton(button, "Adding...", "Added to WooCommerce", true);
      try {
        const priceInput = document.querySelector(".shop-price");
        if (/^\d+$/.test(priceInput.value) && (parseInt(priceInput.value) <= 0)) return notyf.error("Invalid Price");
        const addToWoocommerceRequest = await fetch("/createwoocommerceorder", {
          headers: {
            "Content-Type": "application/json"
          },
          method: "POST",
          body: JSON.stringify({
            designSKU,
            price: parseInt(priceInput.value)
          }),
        });
        const addToWoocommerceResponse = await addToWoocommerceRequest.json();
        console.log(addToWoocommerceResponse);
        if (!addToWoocommerceRequest.ok) {
          document.querySelector("main").removeChild(document.querySelector(".product-modal-wrapper"))
          return notyf.error({
            message: addToWoocommerceResponse.message ?? addToWoocommerceResponse.error,
            dismissible: true,
            duration: 5000
          })
        }
        notyf.success({
          message: "Added to WooCommerce Store!",
          dismissible: true,
          duration: 5000
        })
        const modal = document.querySelector(".product-modal-wrapper")
        if (modal) modal.remove();
      } catch (error) {
        console.log(error);
        notyf.error("Something went wrong!");
      } finally {
        disableButton(button, "Adding...", "Add to WooCommerce", false);
      }
    }

    const downloadDesign = (url) => {
      let aLink = document.createElement("a");
      aLink.href = url;
      aLink.target = "_blank";
      aLink.click();
      aLink.remove();
    }

    const downloadCurrentDesign = (side) => {
      if (!currentModalDesign) {
        notyf.error("No design data available for download");
        return;
      }

      let imageUrl = null;
      if (side === 'front' && currentModalDesign.designImage?.front && currentModalDesign.designImage.front !== 'false') {
        imageUrl = currentModalDesign.designImage.front;
      } else if (side === 'back' && currentModalDesign.designImage?.back && currentModalDesign.designImage.back !== 'false') {
        imageUrl = currentModalDesign.designImage.back;
      }

      if (imageUrl) {
        downloadDesign(imageUrl);
      } else {
        notyf.error(`No ${side} design image available for this variant`);
      }
    }

    // Updated function to handle both standalone and grouped designs
    const openModal = (designSKU, groupId = null) => {
      let designData, allVariants = [];

      if (groupId) {
        // This is a grouped design - find all variants
        // Handle grouped data as an object with groupId keys
        const designs = designsResponseData.grouped && typeof designsResponseData.grouped === 'object'
          ? designsResponseData.grouped[groupId]
          : null;
        if (designs && Array.isArray(designs)) {
          allVariants = designs;
          designData = allVariants.find(design => design.designSKU === designSKU) || allVariants[0];
        }
      } else {
        // Try to find in standalone first
        if (designsResponseData.standalone && Array.isArray(designsResponseData.standalone)) {
          designData = designsResponseData.standalone.find(design => design.designSKU === designSKU);
        }
        // Fallback to original designs array
        if (!designData && designsResponseData.designs && Array.isArray(designsResponseData.designs)) {
          designData = designsResponseData.designs.find(design => design.designSKU === designSKU);
        }
      }

      if (!designData) {
        console.error('Design not found:', designSKU, 'groupId:', groupId);
        return;
      }

      // Store current design data for downloads
      currentModalDesign = designData;

      const currentDesignTax = (designData.price + (designData.neckLabel ? 10 : 0)) * 0.05;
      const isDesignGenerating = (!(designData.designImage?.front) && designData.designImageStatus?.front?.status === "processing" && designData.designImageStatus?.front?.jobId) ||
        (!(designData.designImage?.back) && designData.designImageStatus?.back?.status === "processing" && designData.designImageStatus?.back?.jobId);
      const shouldShowBackByDefault = !(designData.designImage?.front && designData.designImage?.front != "false");
      const defaultImageDirection = shouldShowBackByDefault ? "back" : "front";
      const otherSideImage = defaultImageDirection === "back" ? designData.designImage?.front : designData.designImage?.back;

      // Create color and size options for variants or single design
      const createVariantOptions = () => {
        if (allVariants.length > 1) {
          // Group variants by color and size
          const colorMap = new Map();

          allVariants.forEach(variant => {
            const color = variant.product.color;
            const size = variant.product.size;
            const hex = variant.product.hex;

            if (!colorMap.has(color)) {
              colorMap.set(color, { hex, variants: [], sizes: [] });
            }
            colorMap.get(color).variants.push(variant);
            if (!colorMap.get(color).sizes.includes(size)) {
              colorMap.get(color).sizes.push(size);
            }
          });

          const colors = Array.from(colorMap.entries()).map(([color, data]) => ({
            color,
            hex: data.hex,
            variants: data.variants,
            sizes: data.sizes
          }));

          // Get sizes for the current selected color
          const currentColor = designData.product.color;
          const currentColorData = colors.find(c => c.color === currentColor);
          const availableSizes = currentColorData ? currentColorData.sizes : [designData.product.size];

          return {
            colors: colors,
            sizes: availableSizes, // Only sizes available for current color
            hasVariants: true
          };
        } else {
          // Single design
          return {
            colors: [{ color: designData.product.color, hex: designData.product.hex, variants: [designData], sizes: [designData.product.size] }],
            sizes: [designData.product.size],
            hasVariants: false
          };
        }
      };

      const variantOptions = createVariantOptions();

      const designModalDOMString = `
        <div class="product-modal-wrapper">
          <div class="product-modal" data-aos="fade-up">
            <button class="modal-close">
              <i class="fa fa-close"></i>
            </button>
            <div class="product-modal-image">
              ${isDesignGenerating && !designData.designImage?.front && !designData.designImage?.back ? '<div class="image-processing-overlay"><i class="fa fa-spinner fa-spin"></i> Processing image...</div>' :
          `<img
                id="modal-design-image"
                src="${defaultImageDirection === "back" ? designData.designImage?.back : designData.designImage?.front}"
                alt="Design image"
                ${(otherSideImage && otherSideImage != "false") ? `
                onmouseover="this.src='${otherSideImage}'"
                ` : ''}
                onmouseout="this.src='${defaultImageDirection === "back" ? designData.designImage?.back : designData.designImage?.front}'"
                >`
        }
            </div>
            <div class="product-modal-details">
              <h2 class="product-name" id="modal-design-name">${designData.designName}</h2>
              <div class="product-category-gender">
                <h5 id="modal-product-name">${designData.product.name}</h5>
                <h5 id="modal-design-sku">SKU: ${designData.designSKU}</h5>
              </div>
              <p class="product-description" id="modal-design-description">
                ${designData.description || "User generated design"}
              </p>
              ${variantOptions.hasVariants ? '<div class="alert-info"><i class="fa fa-info-circle"></i>Select different colors and sizes to view variants. You can also move your mouse over the image to flip sides!</div>' : '<div class="alert-info"><i class="fa fa-info-circle"></i>You can move your mouse over the image to flip sides!</div>'}
              
              <!-- Color and Size Selection -->
              <div class="variant-selection">
                <div class="color-selection">
                  <p><strong>Available Colors:</strong></p>
                  <div class="color-options">
                    ${variantOptions.colors.map(colorData => `
                      <div class="color-option ${colorData.color === designData.product.color ? 'selected' : ''}" 
                           data-color="${colorData.color}" 
                           onclick="selectColor('${colorData.color}', '${groupId}')">
                        <div class="color-circle" style="background: ${colorData.hex};" title="${colorData.color}"></div>
                        <span class="color-name">${colorData.color}</span>
                      </div>
                    `).join('')}
                  </div>
                </div>
                
                <div class="size-selection">
                  <p><strong>Available Sizes:</strong></p>
                  <div class="size-options">
                    ${variantOptions.sizes.map(size => `
                      <div class="size-option ${size === designData.product.size ? 'selected' : ''}" 
                           data-size="${size}" 
                           onclick="selectSize('${size}', '${groupId}')">
                        <div class="size-circle">${size}</div>
                      </div>
                    `).join('')}
                  </div>
                </div>
              </div>
  
              <div class="product-price">
                <h4 id="modal-price">Price: ₹${(parseFloat(designData.price.toFixed(2)) + parseFloat(currentDesignTax)).toFixed(2)}</h4>
                <table class="price-breakdown" id="modal-price-breakdown">
                  <tr>
                    <td>Base Price</td>
                    <td>₹${designData.product.price.toFixed(2)}</td>
                  </tr>
                  <tr>
                    <td>Print Price</td>
                    <td>₹${(designData.price - designData.product.price - (designData.neckLabel ? 10 : 0)).toFixed(2)}</td>
                  </tr>
                  ${designData.neckLabel ? `
                    <tr>
                      <td>Neck label Price</td>
                      <td>₹10</td>
                    </tr>
                    `: ''}
                  <tr>
                    <td>Tax</td>
                    <td>₹${currentDesignTax.toFixed(2)}</td>
                  </tr>
                  <tr>
                    <td>Total Price</td>
                    <td>₹${(designData.price + currentDesignTax).toFixed(2)}</td>
                  </tr>
                </table>
              </div>
              <div class="action-buttons">
                <button ${isDesignGenerating ? "disabled='true'" : ''} class="${isDesignGenerating ? 'disabled' : ''}" id="download-front-btn" onclick="downloadCurrentDesign('front')"><i class="fa fa-download"></i> Download Front Design</button>
                <button ${isDesignGenerating ? "disabled='true'" : ''} class="${isDesignGenerating ? 'disabled' : ''}" id="download-back-btn" onclick="downloadCurrentDesign('back')"><i class="fa fa-download"></i> Download Back Design</button>
                <button ${isDesignGenerating ? "disabled='true'" : ''} class="delete-design ${isDesignGenerating ? 'disabled' : ''}" onclick="openDeleteConfirmation(this,'${designData.designName}', '${designData.designSKU}')"><i class="fa fa-trash"></i> Delete Design</button>
              </div>
              <p>Publish:</p>
              <div style="display: flex; gap: 0.4rem; align-items: center;">₹ 
                <input type="number" inputmode="numeric" class="shop-price" value='${(designData.price * 1.05).toFixed(2)}' placeholder="₹" />
                <p style="font-size: 0.84rem">Enter retail price for your shop. <br /> You can change it later in your shop settings:</p>
              </div>
              <div class="publish-buttons">
                <button id="add-shopify" onclick="addToShopify(this, '${designData.designSKU}')" ${designData.isAddedToShopify || isDesignGenerating ? 'class="disabled" disabled="true"' : ''}><i class="fa-brands fa-shopify"></i>${designData.isAddedToShopify ? ' Added to Shopify ✅' : ' Add to Shopify'}</button>
                <button id="add-woocommerce" onclick="addToWooCommerce(this, '${designData.designSKU}')" ${designData.isAddedToWoocommerce || isDesignGenerating ? 'class="disabled" disabled="true"' : ''}><img src="images/WooCommerce_logo.svg" width="30" alt=""> ${designData.isAddedToWoocommerce ? 'Added to WC ☑' : 'Add to WooCommerce'}</button>
              </div>
            </div>
          </div>
        </div>
        `;

      document.querySelector("main").insertAdjacentHTML("beforeend", designModalDOMString);

      // Set initial download button visibility
      const frontBtn = document.getElementById('download-front-btn');
      const backBtn = document.getElementById('download-back-btn');

      if (frontBtn && (!designData.designImage?.front || designData.designImage.front === 'false')) {
        frontBtn.style.display = 'none';
      }

      if (backBtn && (!designData.designImage?.back || designData.designImage.back === 'false')) {
        backBtn.style.display = 'none';
      }

      const closeModalButton = document.querySelector(".modal-close");
      closeModalButton.addEventListener("click", (e) => {
        document.querySelector("main").removeChild(document.querySelector(".product-modal-wrapper"))
      });
    }

    // Function to handle color selection
    const selectColor = (selectedColor, groupId) => {
      if (!groupId) return; // Standalone design, no color switching

      // Handle grouped data as an object with groupId keys
      const designs = designsResponseData.grouped && typeof designsResponseData.grouped === 'object'
        ? designsResponseData.grouped[groupId]
        : null;
      if (!designs || !Array.isArray(designs)) return;

      // Find available sizes for the selected color
      const availableSizes = designs
        .filter(design => design.product.color === selectedColor)
        .map(design => design.product.size);

      // Update size options to show only available sizes for this color
      const sizeOptionsContainer = document.querySelector('.size-options');
      const currentSize = document.querySelector('.size-option.selected')?.dataset.size;

      // Check if current size is available in new color, otherwise pick first available
      const targetSize = availableSizes.includes(currentSize) ? currentSize : availableSizes[0];

      sizeOptionsContainer.innerHTML = availableSizes.map(size => `
          <div class="size-option ${size === targetSize ? 'selected' : ''}" 
               data-size="${size}" 
               onclick="selectSize('${size}', '${groupId}')">
            <div class="size-circle">${size}</div>
          </div>
        `).join('');

      // Find and switch to the target variant
      const targetVariant = designs.find(design =>
        design.product.color === selectedColor &&
        design.product.size === targetSize
      );

      if (targetVariant) {
        updateModalContent(targetVariant, designs);
        updateSelectionUI('color', selectedColor);
      }
    }

    // Function to handle size selection
    const selectSize = (selectedSize, groupId) => {
      if (!groupId) return; // Standalone design, no size switching

      // Handle grouped data as an object with groupId keys
      const designs = designsResponseData.grouped && typeof designsResponseData.grouped === 'object'
        ? designsResponseData.grouped[groupId]
        : null;
      if (!designs || !Array.isArray(designs)) return;

      const currentColor = document.querySelector('.color-option.selected')?.dataset.color;
      const targetVariant = designs.find(design =>
        design.product.color === currentColor &&
        design.product.size === selectedSize
      );

      if (targetVariant) {
        updateModalContent(targetVariant, designs);
        updateSelectionUI('size', selectedSize);
      }
    }

    // Function to update modal content when variant changes
    const updateModalContent = (designData, allVariants) => {
      // Update current design data for downloads
      currentModalDesign = designData;

      const currentDesignTax = (designData.price + (designData.neckLabel ? 10 : 0)) * 0.05;
      const shouldShowBackByDefault = !(designData.designImage?.front && designData.designImage?.front != "false");
      const defaultImageDirection = shouldShowBackByDefault ? "back" : "front";
      const otherSideImage = defaultImageDirection === "back" ? designData.designImage?.front : designData.designImage?.back;

      // Update image
      const imageElement = document.getElementById('modal-design-image');
      if (imageElement && designData.designImage) {
        const newImageSrc = defaultImageDirection === "back" ? designData.designImage?.back : designData.designImage?.front;
        imageElement.src = newImageSrc;

        // Update hover effects
        if (otherSideImage && otherSideImage != "false") {
          imageElement.onmouseover = () => imageElement.src = otherSideImage;
          imageElement.onmouseout = () => imageElement.src = newImageSrc;
        }
      }

      // Update download button visibility and state
      const frontBtn = document.getElementById('download-front-btn');
      const backBtn = document.getElementById('download-back-btn');

      if (frontBtn) {
        if (designData.designImage?.front && designData.designImage.front !== 'false') {
          frontBtn.style.display = 'inline-block';
          frontBtn.classList.remove('disabled');
          frontBtn.removeAttribute('disabled');
        } else {
          frontBtn.style.display = 'none';
        }
      }

      if (backBtn) {
        if (designData.designImage?.back && designData.designImage.back !== 'false') {
          backBtn.style.display = 'inline-block';
          backBtn.classList.remove('disabled');
          backBtn.removeAttribute('disabled');
        } else {
          backBtn.style.display = 'none';
        }
      }

      // Update text content
      document.getElementById('modal-design-name').textContent = designData.designName;
      document.getElementById('modal-product-name').textContent = designData.product.name;
      document.getElementById('modal-design-sku').textContent = `SKU: ${designData.designSKU}`;
      document.getElementById('modal-design-description').textContent = designData.description || "User generated design";
      document.getElementById('modal-price').textContent = `Price: ₹${(parseFloat(designData.price.toFixed(2)) + parseFloat(currentDesignTax)).toFixed(2)}`;

      // Update price breakdown
      const priceBreakdownHTML = `
          <tr>
            <td>Base Price</td>
            <td>₹${designData.product.price.toFixed(2)}</td>
          </tr>
          <tr>
            <td>Print Price</td>
            <td>₹${(designData.price - designData.product.price - (designData.neckLabel ? 10 : 0)).toFixed(2)}</td>
          </tr>
          ${designData.neckLabel ? `
            <tr>
              <td>Neck label Price</td>
              <td>₹10</td>
            </tr>
            `: ''}
          <tr>
            <td>Tax</td>
            <td>₹${currentDesignTax.toFixed(2)}</td>
          </tr>
          <tr>
            <td>Total Price</td>
            <td>₹${(designData.price + currentDesignTax).toFixed(2)}</td>
          </tr>
        `;
      document.getElementById('modal-price-breakdown').innerHTML = priceBreakdownHTML;

      // Update shop price input
      document.querySelector('.shop-price').value = (designData.price * 1.05).toFixed(2);

      // Update buttons
      const shopifyBtn = document.getElementById('add-shopify');
      const woocommerceBtn = document.getElementById('add-woocommerce');

      shopifyBtn.onclick = () => addToShopify(shopifyBtn, designData.designSKU);
      woocommerceBtn.onclick = () => addToWooCommerce(woocommerceBtn, designData.designSKU);

      if (designData.isAddedToShopify) {
        shopifyBtn.classList.add('disabled');
        shopifyBtn.disabled = true;
        shopifyBtn.innerHTML = '<i class="fa-brands fa-shopify"></i> Added to Shopify ✅';
      } else {
        shopifyBtn.classList.remove('disabled');
        shopifyBtn.disabled = false;
        shopifyBtn.innerHTML = '<i class="fa-brands fa-shopify"></i> Add to Shopify';
      }

      if (designData.isAddedToWoocommerce) {
        woocommerceBtn.classList.add('disabled');
        woocommerceBtn.disabled = true;
        woocommerceBtn.innerHTML = '<img src="images/WooCommerce_logo.svg" width="30" alt=""> Added to WC ☑';
      } else {
        woocommerceBtn.classList.remove('disabled');
        woocommerceBtn.disabled = false;
        woocommerceBtn.innerHTML = '<img src="images/WooCommerce_logo.svg" width="30" alt=""> Add to WooCommerce';
      }
    }

    // Function to update selection UI
    const updateSelectionUI = (type, selectedValue) => {
      if (type === 'color') {
        document.querySelectorAll('.color-option').forEach(option => {
          option.classList.remove('selected');
        });
        document.querySelector(`[data-color="${selectedValue}"]`).classList.add('selected');
      } else if (type === 'size') {
        document.querySelectorAll('.size-option').forEach(option => {
          option.classList.remove('selected');
        });
        document.querySelector(`[data-size="${selectedValue}"]`).classList.add('selected');
      }
    }

    const createDesignCards = (data = designsResponseData) => {
      // Store current filtered data
      currentFilteredData = data;

      // Process grouped and standalone designs together
      let allDesigns = [];

      // Add one representative from each group
      // Handle grouped data as an object with groupId keys
      if (data.grouped && typeof data.grouped === 'object') {
        Object.entries(data.grouped).forEach(([groupId, designs]) => {
          if (designs && Array.isArray(designs) && designs.length > 0) {
            const representative = designs.find(des => des.designImage?.front || des.designImage?.back) || designs[0]; // Use first design as representative
            allDesigns.push({
              ...representative,
              isGrouped: true,
              groupId: groupId,
              totalVariants: designs.length,
              allVariants: designs
            });
          }
        });
      }

      // Add standalone designs
      if (data.standalone && data.standalone.length > 0) {
        allDesigns = allDesigns.concat(data.standalone.map(design => ({
          ...design,
          isGrouped: false,
          groupId: null
        })));
      }

      // Fallback to original designs array if no grouped/standalone data
      if (allDesigns.length === 0 && data.designs) {
        allDesigns = data.designs.map(design => ({
          ...design,
          isGrouped: false,
          groupId: null
        }));
      }

      // Sort all designs by creation date
      const sortedDesigns = allDesigns.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

      // Update pagination variables
      totalDesigns = sortedDesigns.length;
      totalPages = Math.ceil(totalDesigns / itemsPerPage);

      // Get paginated data
      const paginatedDesigns = paginateData(sortedDesigns);

      // Update pagination UI
      updatePaginationInfo();
      updatePaginationNav();

      if (paginatedDesigns.length === 0) {
        designsContainer.innerHTML = "<p> No designs yet! </p>";
        return;
      }

      const designCardsDOMString = paginatedDesigns.map(design => {
        // normalize image urls
        if (design.designImage?.front?.includes("printwear.in") && !design.designImage?.front?.includes("admin.printwear.in")) {
          design.designImage.front = design.designImage.front?.replace("printwear.in", "admin.printwear.in");
          design.designImage.back = design.designImage.back?.replace("printwear.in", "admin.printwear.in");
        }
        design.designItems = (design.designItems || []).map(item => {
          if (item?.URL?.includes("printwear.in") && !item?.URL?.includes("admin.printwear.in")) {
            return { ...item, URL: item.URL.replace("printwear.in", "admin.printwear.in") }
          } else return item
        })

        const isDesignGenerating = (!design.designImage?.front && design.designImageStatus?.front?.status === "processing" && design.designImageStatus?.front?.jobId) ||
          (!design.designImage?.back && design.designImageStatus?.back?.status === "processing" && design.designImageStatus?.back?.jobId);

        const cardImage = ((design.designImage && design.designImage.front && design.designImage.front != 'false') ? design.designImage.front : design.designImage?.back || '');

        // Show variant count for grouped designs
        const variantIndicator = design.isGrouped && design.totalVariants > 1
          ? `<div class="variant-indicator">${design.totalVariants} variants</div>`
          : '';

        return `
            <div class="design-card" data-aos="fade-up">
              <div class="card-img">
                ${isDesignGenerating && !cardImage ? '<div class="image-processing-overlay" style="flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column;"><i class="fa fa-spinner fa-spin"></i> Processing image...</div>' : `
                <img src="${cardImage}" loading="lazy">
                `}
                ${variantIndicator}
              </div>
              <div class="name-price">
                <div style="display:flex; gap: 2px; justify-content: space-between; align-items: center">
                  <h3>${design.designName}</h3>
                  <p class='name-sku'>${design.designSKU}</p>
                </div>
                <p style="opacity: 0.8; font-size: 0.6rem">${design.product.style}</p>
              </div>
              <div class="details">
                <div class="view-btn">
                  <button onclick="openModal('${design.designSKU}', ${design.groupId ? `'${design.groupId}'` : 'null'})">View</button>
                </div>
                <p style="font-size: 14px">₹${design.price.toFixed(2)}</p>
              </div>
            </div>
          `
      }).join('\n');
      designsContainer.innerHTML = designCardsDOMString;
    }

    const filterProductsByGender = (e, category) => {
      const filterByGenderButtons = document.querySelectorAll(".filter-button");
      filterByGenderButtons.forEach(filterBtn => filterBtn.classList.remove("filter-button-active"));

      e.target.classList.add("filter-button-active");

      if (category === "all") {
        currentFilteredData = designsResponseData;
        currentPage = 1;
        return createDesignCards();
      }

      // Filter both standalone and grouped designs
      let filteredData = { standalone: [], grouped: {} };

      if (designsResponseData.standalone) {
        filteredData.standalone = designsResponseData.standalone.filter(design =>
          design.product['gender'].toLowerCase().trim() === category.toLowerCase().trim()
        );
      }

      // Handle grouped data as an object with groupId keys
      if (designsResponseData.grouped && typeof designsResponseData.grouped === 'object') {
        Object.entries(designsResponseData.grouped).forEach(([groupId, designs]) => {
          if (designs && Array.isArray(designs)) {
            const matchingDesigns = designs.filter(design =>
              design.product['gender'].toLowerCase().trim() === category.toLowerCase().trim()
            );
            if (matchingDesigns.length > 0) {
              filteredData.grouped[groupId] = designs; // Include the whole group if any design matches
            }
          }
        });
      }

      // Fallback to original designs array
      if (designsResponseData.designs) {
        const designsData = designsResponseData.designs.filter(design => design.product['gender'].toLowerCase().trim() === category.toLowerCase().trim());
        filteredData.designs = designsData;
      }

      if (filteredData.standalone.length === 0 && Object.keys(filteredData.grouped).length === 0 && (!filteredData.designs || filteredData.designs.length === 0)) {
        designsContainer.innerHTML = `No products found for filter: "${category}"`;
        document.getElementById('pagination-nav').style.display = 'none';
        document.getElementById('pagination-info-text').textContent = 'Showing 0 - 0 of 0 designs';
        return;
      }

      currentFilteredData = filteredData;
      currentPage = 1;
      createDesignCards(filteredData);
    }

    const fetchDesignsData = async () => {
      try {
        const designsFetchRequest = await fetch("/getdesigns");

        designsResponseData = await designsFetchRequest.json();
        const { designs, standalone, grouped } = designsResponseData;
        const maleFilterPattern = new RegExp(/\bmen\b|\bmens\b/i);
        const femaleFilterPattern = new RegExp(/\bwomen\b|\bwomens\b/i);

        // Add gender property to designs
        if (designsResponseData.designs) {
          designsResponseData.designs = designsResponseData.designs.map(design => {
            if (maleFilterPattern.test(design.product.name)) design.product['gender'] = "men";
            else if (femaleFilterPattern.test(design.product.name)) design.product['gender'] = "women";
            else design.product['gender'] = "unisex";
            return design;
          })
        }

        // Add gender property to standalone designs
        if (designsResponseData.standalone) {
          designsResponseData.standalone = designsResponseData.standalone.map(design => {
            if (maleFilterPattern.test(design.product.name)) design.product['gender'] = "men";
            else if (femaleFilterPattern.test(design.product.name)) design.product['gender'] = "women";
            else design.product['gender'] = "unisex";
            return design;
          })
        }

        // Add gender property to grouped designs
        // Handle grouped data as an object with groupId keys
        if (designsResponseData.grouped && typeof designsResponseData.grouped === 'object') {
          Object.entries(designsResponseData.grouped).forEach(([groupId, designs]) => {
            if (designs && Array.isArray(designs)) {
              designsResponseData.grouped[groupId] = designs.map(design => {
                if (maleFilterPattern.test(design.product.name)) design.product['gender'] = "men";
                else if (femaleFilterPattern.test(design.product.name)) design.product['gender'] = "women";
                else design.product['gender'] = "unisex";
                return design;
              });
            }
          });
        }

        console.log("Fetched data:", designsResponseData);

        if ((designsResponseData.standalone && designsResponseData.standalone.length > 0) ||
          (designsResponseData.grouped && typeof designsResponseData.grouped === 'object' && Object.keys(designsResponseData.grouped).length > 0) ||
          (designsResponseData.designs && designsResponseData.designs.length > 0)) {
          // Initialize pagination
          currentFilteredData = designsResponseData;
          currentPage = 1;
          return createDesignCards();
        }
        designsContainer.innerHTML = "<p> No designs yet! </p>";
        document.getElementById('pagination-nav').style.display = 'none';
        document.getElementById('pagination-info-text').textContent = 'Showing 0 - 0 of 0 designs';
      } catch (error) {
        designsContainer.innerHTML = `
            <p>
              There was an error trying to fetch data. <br>
              ${error}
            </p>
          `;
        document.getElementById('pagination-nav').style.display = 'none';
        document.getElementById('pagination-info-text').textContent = 'Showing 0 - 0 of 0 designs';
        console.log(error);
      }
    }

    fetchDesignsData();
  </script>

</body>

</html>