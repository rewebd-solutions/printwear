<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/recharge.css">
    <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v6.0.0-beta3/css/all.css">
    <script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <title>Recharge wallet for <%= data.userName %>
    </title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H19W9PLCHF">
    </script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-H19W9PLCHF');
    </script>
</head>

<body>
    <% if (data.error) { %>
        <h1>Oops! You shouldn't be here</h1>
    <% } else { %>
        <div class="wallet-box">
            <img src="/images/Logo.png" alt="Printwear logo" />
            <h5><i class="fa fa-info-circle"></i> Your last successful recharge was on
                <% for( let i = data.walletData.transactions.length - 1; i >= 0; i-- ) { %>
                    <% if (data.walletData.transactions[i].transactionStatus == "success" && data.walletData.transactions[i].transactionType == "recharge") { %>
                        <%= new Date(data.walletData.transactions[i].transactionDate).toLocaleString() %>
                        for ₹<%= data.walletData.transactions[i].amount %> 
                        <% break %>
                    <% } %>
                <% } %>
            </h5>
            <h4>Enter amount to add to wallet</h4>
            <div class="input-wrapper">
                <input type="text" inputmode="numeric" placeholder="250">
            </div>
            <div class="button-row">
                <button class="pay-button">Pay</button>
                <button class="cancel-button" onclick="handleCancel()">Cancel</button>
            </div>
        </div>
        <script>
            var notyf = new Notyf();

            const rechargeInput = document.querySelector(".input-wrapper input");
            rechargeInput.oninput = (e) => {
                let instrin = e.target.value;
                e.target.value = instrin.replace(/[^0-9]/g, '');
            }
            const handleCancel = () => {
                window.postMessage({ goTo: 'successfull' }, location.origin);
                window.close();
            }

            setTimeout(() => {
                window.close();
            }, 1000 * 90);

            document.querySelector(".pay-button").addEventListener("click", async (e) => {
                try {
                    // make a fetch to backend
                    const rechargeRequest = await fetch("/recharge", {
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            amount: rechargeInput.value
                        }),
                        method: "POST"
                    });
                    const rechargeResponse = await rechargeRequest.json();
                    console.log("🚀 ~ document.querySelector ~ rechargeResponse:", rechargeResponse)
                    if (!rechargeRequest.ok) {
                        return notyf.error(rechargeResponse.message);
                    }
                    var options = {
                        "key": "rzp_live_Kd1ukYRxGm7ir4", // Enter the Key ID generated from the Dashboard
                        "amount": rechargeResponse.amount, // Amount is in currency subunits. Default currency is INR. Hence, 50000 refers to 50000 paise
                        "currency": "INR",
                        "name": "Printwear", //your business name
                        "description": "Recharge Wallet",
                        "image": "https://printwear.in/images/Logo.png",
                        "order_id": rechargeResponse.id, //This is a sample Order ID. Pass the `id` obtained in the response of Step 1
                        "callback_url": "https://printwear.in/payment-success",
                        "prefill": { //We recommend using the prefill parameter to auto-fill customer's contact information especially their phone number
                            "name": rechargeResponse.name, //your customer's name
                            "email": rechargeResponse.email,
                            "contact": rechargeResponse.phone //Provide the customer's phone number for better conversion rates 
                        },
                        "notes": {
                            "reason": rechargeResponse.notes.message
                        },
                        "theme": {
                            "color": "#3399cc"
                        }
                    };
                    var rzp1 = new Razorpay(options);
                    rzp1.open();
                } catch (error) {
                    console.log(error);
                    notyf.error("There was an error in creating payment")
                    // handleCancel();
                }
            });
        </script>
    <% } %>
</body>

</html>