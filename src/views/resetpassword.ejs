<!DOCTYPE html>
<html>

<head>
    <title>Reset password</title>
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href='https://fonts.googleapis.com/css?family=Nunito' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
    <link rel="stylesheet" href="/css/login.css">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H19W9PLCHF">
    </script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-H19W9PLCHF');
    </script>
</head>

<body>
    <div class="hero">
        <div class="form-box" data-aos="fade-down">
            <% if (!data?.validToken) { %>
                <!-- Initial Email Form -->
                <form id="reset-request" class="input-group" action="/initiate-reset" method="post" style="left: 50px">
                    <h3 style="color: white;">Enter your email to reset password</h3>
                    <input type="email" name="email" class="input-field" placeholder="Email" required />
                    <button class="submit-btnx">Send Reset Link</button>
                </form>
                <% } else { %>
                <!-- Password Reset Form -->
                <form id="password-reset" class="input-group" action="/reset-password" method="post" style="left: 50px">
                    <h3 style="color: white;">Enter New Password</h3>
                    <input type="hidden" name="token" value="<%= data.token %>">
                    <div style="position: relative;">
                        <input type="password" name="password" title="Password should have atleast 8 characters"
                            class="input-field" id="pwd-field" pattern=".{8,}" placeholder="Enter New Password"
                            required />
                        <i class="fa fa-eye-slash"
                            style="position: absolute; color: white; right: 1rem; top: 50%; transform: translateX(50%) translateY(-50%);"
                            onclick="togglePwdVisibility(event)"></i>
                    </div>
                    <input type="password" name="confirmPassword" title="Password should have atleast 8 characters"
                        class="input-field" pattern=".{8,}" placeholder="Confirm New Password" required />
                    <button class="submit-btnx">Reset Password</button>
                </form>
                <% } %>
        </div>
    </div>
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
        AOS.init();
        var notyf = new Notyf();
        <% if (data?.error) { %>
            notyf.error("<%= data.error %>");
        <% } %>
        <% if (data?.message) { %>
            notyf.success("<%= data.message %>");
        <% } %>

        if (data?.error) {
            console.log("<%= data.error %>");
            notyf.error("<%= data.error %>");
        }
        function togglePwdVisibility(e) {
            const currentBtnClass = e.target.classList;
            console.log("🚀 ~ togglePwdVisibility ~ currentBtnClass:", currentBtnClass)
            if (currentBtnClass.contains("fa-eye-slash")) {
                e.target.classList.replace("fa-eye-slash", "fa-eye");
                document.querySelector("#pwd-field").setAttribute("type", "text")
                return;
            }
            e.target.classList.replace("fa-eye", "fa-eye-slash");
            document.querySelector("#pwd-field").setAttribute("type", "password")
        }
    </script>

</body>

</html>