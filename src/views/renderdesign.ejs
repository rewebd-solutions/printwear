<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/fabric@4.5.1/dist/fabric.min.js"></script>
    <title>Render design</title>
    <style>
        * {
            padding: 0;
            margin: 0;
            box-sizing: border-box;
        }

        body {
            height: 100vh;
        }

        #product-layers {
            height: 100%;
            display: flex;
            position: relative;
            justify-content: center;
            align-items: center;
        }

        #product-image {
            height: 770px;
            position: absolute;
            z-index: -5;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        #style-layer {
            position: absolute;
            height: 100%;
            width: fit-content;
        }

        .cover {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            height: 770px;
            transform: scale(2);
            transform-origin: top left;
    }

        /* .canvas-container {
            border: 1px dashed white;
        } */
    </style>
</head>

<body>
    <div class="cover">
        <div id="product-layers">
            <img alt="Image" id="product-image">
            <canvas id="style-layer"></canvas>
        </div>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const baseImage = urlParams.get("image");
        const overlayImage = urlParams.get("overlay");
        const imageWidth = Number(urlParams.get("width"));
        const imageHeight = Number(urlParams.get("height"));
        const imageTop = Number(urlParams.get("top"));
        const imageLeft = Number(urlParams.get("left"));

        const originalHeight = 500;
        const newHeight = 770;

        const canvas = document.getElementById("style-layer");
        const image = document.getElementById("product-image");
        image.setAttribute("src", baseImage);
        image.onload = () => {
            const baseImageWidth = image.clientWidth;
            const baseImageHeight = image.clientHeight;

            /** Calculate ratios like in fabric-designer but with height of 770 instead of 500 */
            const inchToPixelRatio = newHeight / 28;
            const pixelToInchRatio = 28 / newHeight;

            /** Following 2 values from zohoproducts[].canvas["front" | "back"] */
            const productWidth = 13;
            const productHeight = 18;

            const canvasWidth = inchToPixelRatio * productWidth;
            const canvasHeight = inchToPixelRatio * productHeight;

            /** Setup canvas */
            canvas.setAttribute("width", canvasWidth);
            canvas.setAttribute("height", canvasHeight);

            /** Setup fabric JS */
            const fabricCanvas = new fabric.Canvas(canvas);

            fabricCanvas.skipOffscreen = true;
            fabricCanvas.stateful = true;
            fabricCanvas.uniformScaling = true;


            fabricCanvas.on("object:moving", (e) => {
                console.log("moving", e);
            })

            fabricCanvas.on("object:scaling", (e) => {
                console.log("scaling", e);
            })

            /** Setup design image overlay */
            fabric.Image.fromURL(overlayImage, (img) => {
                const scaleX = (imageWidth * newHeight) / (28 * img.width);
                const scaleY = (imageHeight * newHeight) / (28 * img.height);
                // img.scaleToHeight(100);
                img.set({
                    // left: (baseImageWidth / pixelToInchRatio - imageWidth / pixelToInchRatio) / 2 + imageLeft / pixelToInchRatio,
                    // top: (baseImageHeight / pixelToInchRatio - imageHeight / pixelToInchRatio) / 2 + imageTop / pixelToInchRatio,
                    // top: ((imageTop / 321) * baseImageHeight),
                    // left: ((imageLeft / 232) * baseImageWidth),
                    top: (imageTop / 500) * newHeight,
                    left: (imageLeft / 500) * newHeight,
                    scaleX: scaleX,
                    scaleY: scaleY
                });
                fabricCanvas.add(img);
                fabricCanvas.renderAll();
            }, { crossOrigin: 'anonymous' });
        }
    </script>
</body>

</html>